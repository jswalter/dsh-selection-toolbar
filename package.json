{
  "name": "dsh-selection-toolbar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "macOS 全局划词：语法修正、翻译、解释、追问及原位替换，使用 DSH 模型路由。",
  "main": "host.mjs",
  "exports": {
    ".": "./host.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "files": [
    "host.mjs",
    "config.mjs",
    "client.js",
    "index.mjs",
    "engine.mjs",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "native",
    "scripts",
    "test",
    "install.command",
    "README.md",
    "RESEARCH.md",
    "VALIDATION.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "sh scripts/test.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jswalter/dsh-selection-toolbar.git"
  },
  "homepage": "https://github.com/jswalter/dsh-selection-toolbar#readme",
  "bugs": {
    "url": "https://github.com/jswalter/dsh-selection-toolbar/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
